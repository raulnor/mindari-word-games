<html lang="en">
    <head>
        <meta name="viewport" content="width=device-width, initial-scale=1">
        <title>Unknown Games</title>
        <style>{{.Style}}</style>
        <script>
        </script>
    </head>
    <body>
        <h1><a href="/" style="text-decoration: none">&lt;</a>Unknown Games</h1>
        <table>
            <thead>
                <tr>
                    <th>Username</th>
                    <th>Score</th>
                </tr>
            </thead>
            <tbody>
                {{range .Scores}}
                <tr>
                    <td><a href="/user?name={{.Username}}">{{.Username}}</a></td>
                    <td>{{.Score}}</td>
                </tr>
                {{end}}
            </tbody>
        </table>
    </body>
</html>